# ── App ─────────────────────────────────────────────────────────────
APP_NAME=S309 AI
DEBUG=false

# ── LLM ─────────────────────────────────────────────────────────────
# Agent (아침/식후 코칭) — Claude API
ANTHROPIC_API_KEY=

# 주간 보고서 LLM — GPT-4o
OPENAI_API_KEY=

# ── AWS S3 (주간 보고서 PDF 저장) ────────────────────────────────────
# BE의 S3 설정과 동일 버킷 사용
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
# 로컬 MinIO / LocalStack 사용 시만 설정 (운영 환경에서는 비워둠)
# AWS_S3_ENDPOINT=http://localhost:9000

# ── 혈당 예측 모델 ───────────────────────────────────────────────────
