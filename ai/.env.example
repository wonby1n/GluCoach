# App
APP_NAME=S309 AI
DEBUG=false

# Anthropic API (LLM 리포트 기능 사용 시 필요, 없으면 fallback 메시지 반환)
# ANTHROPIC_API_KEY=

# ── 혈당 예측 모델 설정 ────────────────────────────────────────────────
# 모델 파일 디렉토리 (기본: models)
# GLUCOSE_MODELS_DIR=models

# scaler 경로 (기본: GLUCOSE_MODELS_DIR/scaler.pkl)
# GLUCOSE_SCALER_PATH=models/scaler.pkl

# 사용할 예측 모델 아키텍처: lstm | mlp | ridge (기본: lstm, 권장)
# GLUCOSE_MEAL_MODEL_TYPE=lstm

# ── 파인튜닝 파라미터 (기본값 그대로 사용 권장) ─────────────────────────
# GLUCOSE_FINETUNE_EPOCHS=30
# GLUCOSE_FINETUNE_LR=0.0003
# GLUCOSE_FINETUNE_RECENT_N=42
# GLUCOSE_PERSONALIZED_MAX_AGE_DAYS=90
