[*.kt]
# 이 모듈은 외부 의존성(Samsung Health Data SDK, 커스텀 IME) 통합용 격리 모듈로
# 소스 형태를 보존하기 위해 일부 ktlint 룰을 완화한다.
# - max-line-length: HealthDebugActivity 의 디버그 안내 메시지 / HangulComposer 의 한글 자모 매핑 라인이 길게 유지될 필요가 있음.
# - property-naming: GlucoseKeyboard 가 키 배열을 SCREAMING_SNAKE_CASE 상수(KO_ROW1 등)로 표현하는 것이 가독성에 더 적합.
ktlint_standard_max-line-length = disabled
ktlint_standard_property-naming = disabled
