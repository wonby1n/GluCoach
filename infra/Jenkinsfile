pipeline {
    agent any

    environment {
        // EC2 받으면 아래 IP만 수정
        EC2_HOST    = 'ubuntu@<EC2-IP>'
        EC2_KEY     = credentials('ec2-ssh-key')
        DEPLOY_PATH = '/home/ubuntu/S14P31S309'
        BRANCH      = 'develop'
    }

    triggers {
        gitlab(triggerOnPush: true, branchFilterType: 'NameBasedFilter', includeBranchesSpec: 'develop')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy to EC2') {
            steps {
                sshagent(['ec2-ssh-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${EC2_HOST} '
                            cd ${DEPLOY_PATH} &&
                            git pull origin ${BRANCH} &&
                            docker compose -f infra/docker-compose.yml --env-file infra/.env up -d --build --remove-orphans
                        '
                    """
                }
            }
        }

        stage('Health Check') {
            steps {
                sshagent(['ec2-ssh-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${EC2_HOST} '
                            sleep 15 &&
                            docker compose -f ${DEPLOY_PATH}/infra/docker-compose.yml ps &&
                            curl -sf http://localhost/api/health || (echo "Health check failed" && exit 1)
                        '
                    """
                }
            }
        }
    }

    post {
        success {
            echo '✅ 배포 성공!'
        }
        failure {
            echo '❌ 배포 실패 — Jenkins 로그를 확인하세요.'
        }
        always {
            cleanWs()
        }
    }
}
